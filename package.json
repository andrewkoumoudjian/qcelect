{
  "name": "qcelect",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @qcelect/web dev",
    "dev:worker": "pnpm --filter @qcelect/worker dev",
